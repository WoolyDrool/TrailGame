; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hallows Well"
config/description="Explore the Farway. Collect treasures."
config/tags=PackedStringArray("game")
run/main_scene="uid://chs8oja85k8ks"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://Content/sprites/icon.svg"

[autoload]

GameManager="*res://App/GameManager.gd"
PocketManager="*res://Game/components/pocket_component.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
GlobalAudioManager="*res://App/global_audio_manager.gd"
UiPlayerInterface="*res://Game/interface/player/ui_player_interface.gd"

[dialogic]

directories/dch_directory={
"lab_tech": "res://Content/dialogue/characters/lab_tech.dch",
"navigator": "res://Content/dialogue/characters/navigator.dch",
"random_guy": "res://Content/dialogue/characters/random_guy.dch",
"receptionist_bunny": "res://Content/dialogue/characters/receptionist_bunny.dch",
"smug_guy": "res://Content/dialogue/characters/smug_guy.dch"
}
directories/dtl_directory={
"map_hub_labTech_intro": "res://Content/dialogue/conversations/map_hub_labTech_intro.dtl",
"map_hub_navigator_intro": "res://Content/dialogue/conversations/map_hub_navigator_intro.dtl",
"map_intro_chairGuy": "res://Content/dialogue/conversations/map_intro_chairGuy.dtl",
"map_intro_randomGuy": "res://Content/dialogue/conversations/map_intro_randomGuy.dtl",
"map_intro_receptionist": "res://Content/dialogue/conversations/map_intro_receptionist.dtl",
"map_lostMine_tutorialNPC": "res://Content/dialogue/conversations/map_lostMine_tutorialNPC.dtl"
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.04
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
audio/max_channels=4.0
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
glossary/default_case_sensitive=true
layout/style_list=["res://Content/dialogue/bwauh.tres"]
layout/default_style="res://Content/dialogue/bwauh.tres"
variables={
"unfriendly": 0
}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_position_type=2

[dotnet]

project/assembly_name="Hallows Well"

[editor_plugins]

enabled=PackedStringArray("res://addons/boujie_water_shader/plugin.cfg", "res://addons/csg_terrain/plugin.cfg", "res://addons/dialogic/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/portals/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://App/": "blue",
"res://Content/": "yellow",
"res://Content/maps/": "yellow",
"res://Game/": "red",
"res://Game/interface/": "red",
"res://Game/player/": "red",
"res://addons/": "pink"
}

[global_group]

interactable="Can be interacted with by the player throbber"
items="Objective items like trash, recycling"
missions="area missions"
player="da player"
pickable="Can be skewered by the picker"
pocketable="Can be placed in players pockets"
depositable="Can be deposited in deposit points"
grabbable="Can be grabbed with the players hands"
choppable="Can be chopped with the hatchet"
diggable="Can be dug with the shovel"

